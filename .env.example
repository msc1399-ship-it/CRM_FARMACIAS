# Servidor local accesible por LAN/Tailscale
CRM_HOST=0.0.0.0
CRM_PORT=8000

# Base de datos local
CRM_DB_PATH=./local_data/crm_farmacias.sqlite

# Excel maestro de farmacias
CRM_EXCEL_PATH=C:/Users/Manuel/Desktop/PROYECTO/BASE_DATOS/FARMACIAS_CYL.xlsx

# Carpeta fisica donde el CRM creara expedientes y guardara documentos
EXPEDIENTES_ROOT=./local_data/expedientes

# Puente desacoplado hacia el software analitico.
# Opcion A: API local que reciba {"expediente_id": int, "documents_path": str}
ANALYTICS_API_URL=

# Opcion B: comando local. El CRM anadira la ruta de documentos como ultimo argumento.
ANALYTICS_COMMAND=
